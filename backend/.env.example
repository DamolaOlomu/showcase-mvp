# SQLite for local dev (default, zero setup):
DATABASE_URL=sqlite:///./showcase.db

# Or Postgres (matches docker-compose.yml):
# DATABASE_URL=postgresql://showcase:showcase@localhost:5432/showcase

SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Local storage for MVP. Swap for S3/R2 in Batch 2+ (see app/storage.py).
UPLOAD_DIR=./static/uploads
PUBLIC_BASE_URL=http://localhost:8000

CORS_ORIGINS=http://localhost:3000

# Batch 2 — AI-powered submission. Optional: leave blank and the capture
# endpoint still works (screenshots only), it just skips AI tagging and
# falls back to a title derived from the domain name.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Batch 5 — comma-separated usernames who get admin access (the moderation
# dashboard at /admin, plus admin-only API routes). Add your own username
# here after you sign up once, e.g. ADMIN_USERNAMES=yourname,teammate
ADMIN_USERNAMES=
CAPTURE_RATE_LIMIT_PER_HOUR=10

# Storage backend for uploaded/captured screenshots.
# "local" (default): saves to disk, zero config, fine for local dev — but
#   DON'T use this in production on Railway/Render/similar, since their
#   filesystems are ephemeral and every screenshot is lost on redeploy.
# "s3": required before a real launch. Works with AWS S3 or Cloudflare R2
#   (or any S3-compatible provider). See README's deployment section.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=
